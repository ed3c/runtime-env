# Generated by runtime-env. Values are placeholders, never credentials.
# required; secret: Password for a local Forgejo account; prefer a credential helper over dotenv storage.
FORGEJO_PASSWORD=
# optional; non-secret: Base URL of the local Forgejo instance.
FORGEJO_URL=http://localhost:3000
# required; non-secret: Login name of the local Forgejo account.
FORGEJO_USERNAME=
