# Generated by runtime-env. Values are placeholders, never credentials.
# required; secret: Browserbase API credential.
BROWSERBASE_API_KEY=
# required; non-secret: Browserbase project identifier.
BROWSERBASE_PROJECT_ID=
# required; secret: E2B cloud sandbox API credential.
E2B_API_KEY=
# required; secret: Google Gemini API credential.
GEMINI_API_KEY=
# optional; non-secret: Model identifier selected by natural-language browser tooling.
NL_MODEL=google/gemini-2.0-flash
# optional; non-secret: Natural-language provider selector such as ollama or gemini.
NL_PROVIDER=gemini
