{
  "schema": "runtime-env/workload/v2",
  "id": "stealth-browser-mcp",
  "summary": "Serve bounded stealth browser tools while persistent cookie state remains outside the agent filesystem.",
  "profile": "stealth-browser-local",
  "host": "local-macos",
  "entrypoints": {
    "mcp-smoke": ["node", "scripts/runtime-env/smoke-mcp-server.mjs"],
    "test": ["npm", "test"]
  },
  "acceptance_entrypoints": ["test", "mcp-smoke"],
  "public_test_entrypoints": ["test"],
  "broker_adapters": {
    "mcp-smoke": {"implementation": "scripts/runtime-env/smoke-mcp-server.mjs", "private_state": ["STEALTH_PROFILE_ROOT outside every Git checkout"], "receipt": "runtime-env execution receipt plus MCP handshake hash"}
  },
  "entrypoint_environment": {
    "mcp-smoke": ["STEALTH_BROWSER_EXTRA_ALLOW", "STEALTH_BROWSER_ROOT", "STEALTH_PROFILE_ROOT", "STEALTH_DEBUG_LOG", "STEALTH_LANGUAGES", "STEALTH_USER_AGENT"],
    "test": []
  },
  "secret_delivery": "broker-only",
  "agent_secret_access": "denied",
  "mutation": "workspace",
  "evidence": {
    "receipt": "runtime-env execution receipt plus MCP handshake hash",
    "control": "tests/"
  }
}
