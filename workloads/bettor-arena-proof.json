  },
  "acceptance_entrypoints": ["prove-equivalence", "control-equivalence", "claude-auth-status", "codex-login-status", "forgejo-credential-canary", "agy-model-inventory", "research-browser-health", "stealth-browser-control", "stealth-profile-hygiene", "carrier-contract", "equivalence-live"],
  "public_test_entrypoints": ["control-equivalence", "carrier-contract"],
  "broker_adapters": {
    "claude-auth-status": {"implementation": "scripts/runtime-env/check-carrier-status.py claude", "private_state": ["macOS Keychain and Claude-owned host state"], "receipt": "bounded authentication-state execution receipt"},
    "codex-login-status": {"implementation": "scripts/runtime-env/check-carrier-status.py codex", "private_state": ["Codex-owned OS keyring or auth file outside the target"], "receipt": "bounded login-state execution receipt"},
    "forgejo-credential-canary": {"implementation": "@runtime-env/scripts/verify-local-runtime.sh --credential-helper-only", "private_state": ["URL-scoped macOS Keychain Git credential helper"], "receipt": "authenticated read-only canary execution receipt"},
    "agy-model-inventory": {"implementation": "scripts/runtime-env/check-carrier-status.py agy", "private_state": ["~/.gemini/antigravity-cli/"], "receipt": "exact model-inventory execution receipt"},
    "research-browser-health": {"implementation": "scripts/runtime-env/check-research-cdp.py", "private_state": ["dedicated logged-in browser profile behind loopback CDP"], "receipt": "bounded CDP-health execution receipt"},
    "stealth-browser-control": {"implementation": "scripts/runtime-env/check-stealth-browser.sh", "private_state": ["STEALTH_PROFILE_ROOT outside every Git checkout"], "receipt": "broker-owned file-sink receipt"},
    "equivalence-live": {"implementation": "scripts/runtime-env/run-equivalence-live.py", "private_state": ["digest-bound approval receipt and broker-owned run root"], "receipt": "digest-bound technical-equivalence live receipt"}
  },
  "entrypoint_environment": {
    "prove-equivalence": ["ANTIGRAVITY_PEER", "SKILL_BETTOR_PEER"],
    "control-equivalence": ["ANTIGRAVITY_PEER", "SKILL_BETTOR_PEER"],
    "claude-auth-status": [],
    "codex-login-status": ["CODEX_HOME"],
    "forgejo-credential-canary": [],
    "agy-model-inventory": ["AGY_MODEL", "AGY_EFFORT"],
    "research-browser-health": ["DR_CDP_URL"],
    "stealth-browser-control": ["STEALTH_BROWSER_ROOT", "STEALTH_PROFILE_ROOT"],
    "stealth-profile-hygiene": ["STEALTH_BROWSER_ROOT", "STEALTH_PROFILE_ROOT"],
    "carrier-contract": [],
    "equivalence-live": ["ANTIGRAVITY_PEER", "DR_CDP_URL", "EQUIVALENCE_APPROVAL_RECEIPT_PATH", "EQUIVALENCE_REQUEST_PATH", "EQUIVALENCE_RUN_ROOT", "SKILL_BETTOR_PEER"]
