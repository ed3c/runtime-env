    "control-equivalence": ["sh", "loopctl/loopctl.sh", "equivalence", "test", "--force-receipt"],
    "claude-auth-status": ["python3", "scripts/runtime-env/check-carrier-status.py", "claude"],
    "codex-login-status": ["python3", "scripts/runtime-env/check-carrier-status.py", "codex"],
    "forgejo-credential-canary": ["/bin/bash", "@runtime-env/scripts/verify-local-runtime.sh", "--credential-helper-only"],
