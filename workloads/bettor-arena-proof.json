{
  "schema": "runtime-env/workload/v1",
  "id": "bettor-arena-proof",
  "summary": "Generate bettor-arena proof receipts and run independent controls.",
  "profile": "bettor-arena-runtime-local",
  "host": "local-macos",
  "entrypoints": {
    "prove-equivalence": ["sh", "loopctl/loopctl.sh", "equivalence", "prove", "--force-receipt"],
    "control-equivalence": ["sh", "loopctl/loopctl.sh", "equivalence", "test", "--force-receipt"],
    "claude-auth-status": ["python3", "scripts/runtime-env/check-carrier-status.py", "claude"],
    "codex-login-status": ["python3", "scripts/runtime-env/check-carrier-status.py", "codex"],
    "agy-model-inventory": ["python3", "scripts/runtime-env/check-carrier-status.py", "agy"],
    "research-browser-health": ["python3", "scripts/runtime-env/check-research-cdp.py"],
    "stealth-browser-control": ["sh", "scripts/runtime-env/check-stealth-browser.sh"],
    "equivalence-live": ["python3", "scripts/runtime-env/run-equivalence-live.py"]
  },
  "entrypoint_environment": {
    "prove-equivalence": ["ANTIGRAVITY_PEER", "SKILL_BETTOR_PEER"],
    "control-equivalence": ["ANTIGRAVITY_PEER", "SKILL_BETTOR_PEER"],
    "claude-auth-status": [],
    "codex-login-status": ["CODEX_HOME"],
    "agy-model-inventory": ["AGY_MODEL", "AGY_EFFORT"],
    "research-browser-health": ["DR_CDP_URL"],
    "stealth-browser-control": ["STEALTH_BROWSER_ROOT"],
    "equivalence-live": ["ANTIGRAVITY_PEER", "DR_CDP_URL", "EQUIVALENCE_APPROVAL_RECEIPT_PATH", "EQUIVALENCE_REQUEST_PATH", "EQUIVALENCE_RUN_ROOT", "SKILL_BETTOR_PEER"]
  },
  "secret_delivery": "broker-only",
  "agent_secret_access": "denied",
  "mutation": "workspace",
  "evidence": {
    "receipt": "data/proof-workflow/equivalence-<commit12>.json",
    "control": "data/proof-workflow/control-equivalence-<commit12>.json"
  }
}
