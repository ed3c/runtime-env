{
  "schema": "runtime-env/workload/v1",
  "id": "ios-testflight-verify",
  "summary": "Verify App Store Connect authentication without uploading a build.",
  "profile": "ios-testflight-ship-local",
  "host": "local-macos",
  "entrypoints": {
    "preflight": ["bash", ".agents/skills/ios-testflight-ship/scripts/preflight.sh"],
    "verify-asc": ["bash", ".agents/skills/ios-testflight-ship/scripts/ship.sh", "<target-repo>", "verify_asc"]
  },
  "entrypoint_environment": {
    "preflight": ["APPLE_TEAM_ID", "ASC_ISSUER_ID", "ASC_KEY_ID", "ASC_KEY_PATH", "DEVELOPER_DIR", "IOS_DEVICE_UDID", "JAVA_HOME", "MATCH_PASSWORD"],
    "verify-asc": ["APPLE_TEAM_ID", "ASC_ISSUER_ID", "ASC_KEY_ID", "ASC_KEY_PATH", "DEVELOPER_DIR", "IOS_DEVICE_UDID", "JAVA_HOME", "MATCH_PASSWORD"]
  },
  "secret_delivery": "broker-only",
  "agent_secret_access": "denied",
  "mutation": "read-only",
  "evidence": {
    "receipt": "broker-receipts/ios-testflight-verify/<run-id>.json",
    "control": ".agents/skills/ios-testflight-ship/tests/run-all.sh"
  }
}
