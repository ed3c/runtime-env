{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/runtime-env/blob/main/contracts/profile.schema.json",
  "title": "runtime-env profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "summary", "modules"],
  "properties": {
    "schema": {"const": "runtime-env/profile/v1"},
    "id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "modules": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
