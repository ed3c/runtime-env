{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/runtime-env/blob/main/contracts/consumer-workload.schema.json",
  "title": "runtime-env consumer workload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding", "source", "workload", "content_sha256"],
  "properties": {
    "schema": {"const": "runtime-env/consumer-workload/v1"},
    "binding": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "workload": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
