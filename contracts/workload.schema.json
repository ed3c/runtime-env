{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/runtime-env/blob/main/contracts/workload.schema.json",
  "title": "runtime-env workload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "summary", "profile", "host", "entrypoints", "secret_delivery", "agent_secret_access", "mutation", "evidence"],
  "properties": {
    "schema": {"const": "runtime-env/workload/v1"},
    "id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "host": {"enum": ["local-macos", "openshell"]},
    "entrypoints": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "secret_delivery": {"enum": ["none", "openshell-provider", "broker-only"]},
    "agent_secret_access": {"const": "denied"},
    "mutation": {"enum": ["read-only", "workspace", "external-release"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "control"],
      "properties": {
        "receipt": {"type": "string", "minLength": 1},
        "control": {"type": "string", "minLength": 1}
      }
    }
  }
}
