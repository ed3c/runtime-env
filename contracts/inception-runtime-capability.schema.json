{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-env.invalid/contracts/inception-runtime-capability.schema.json",
  "title": "Inception runtime capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload",
    "policy",
    "environment_names",
    "workspace_lease",
    "capabilities",
    "cleanup",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "runtime-env/inception-runtime-capability/v1"},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image_digest", "argv", "timeout_seconds", "resources"],
      "properties": {
        "name": {"const": "inception-agent-probe"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_millis", "memory_mb", "pids", "output_bytes"],
          "properties": {
            "cpu_millis": {"type": "integer", "minimum": 100, "maximum": 8000},
            "memory_mb": {"type": "integer", "minimum": 64, "maximum": 16384},
            "pids": {"type": "integer", "minimum": 1, "maximum": 512},
            "output_bytes": {"type": "integer", "minimum": 1024, "maximum": 67108864}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_digest", "network", "privileged", "host_mounts", "run_as_root"],
      "properties": {
        "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "network": {"enum": ["NONE", "ALLOWLIST_ONLY"]},
        "privileged": {"const": false},
        "host_mounts": {"type": "array", "maxItems": 0},
        "run_as_root": {"const": false}
      }
    },
    "environment_names": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
    },
    "workspace_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "workspace_name", "expires_at"],
      "properties": {
        "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "workspace_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streaming_visibility",
        "safe_transaction_boundary",
        "cancellation",
        "resume",
        "assistant_prefill",
        "tokenizer_identity",
        "context_limit",
        "tool_call_transactions",
        "hidden_reasoning_access"
      ],
      "properties": {
        "streaming_visibility": {"$ref": "#/$defs/capabilityState"},
        "safe_transaction_boundary": {"$ref": "#/$defs/capabilityState"},
        "cancellation": {"$ref": "#/$defs/capabilityState"},
        "resume": {"$ref": "#/$defs/capabilityState"},
        "assistant_prefill": {"$ref": "#/$defs/capabilityState"},
        "tokenizer_identity": {"$ref": "#/$defs/capabilityState"},
        "context_limit": {"$ref": "#/$defs/capabilityState"},
        "tool_call_transactions": {"$ref": "#/$defs/capabilityState"},
        "hidden_reasoning_access": {"const": "ABSENT"}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descendants_terminated", "workspace_removed", "residue_inventory_required"],
      "properties": {
        "descendants_terminated": {"const": true},
        "workspace_removed": {"const": true},
        "residue_inventory_required": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline_contract", "local_execution", "provider_observation"],
      "properties": {
        "offline_contract": {"enum": ["PASS", "FAIL"]},
        "local_execution": {"enum": ["NOT_EXERCISED", "PASS", "FAIL", "BLOCKED"]},
        "provider_observation": {"enum": ["NOT_EXERCISED", "PASS", "FAIL", "BLOCKED"]}
      }
    }
  },
  "$defs": {
    "capabilityState": {
      "enum": ["UNKNOWN", "UNSUPPORTED", "NOT_EXERCISED", "SUPPORTED"]
    }
  }
}
