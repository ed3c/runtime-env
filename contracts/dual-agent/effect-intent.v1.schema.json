{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-env.invalid/contracts/dual-agent/effect-intent.v1.schema.json",
  "title": "Dual-Agent Effect Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "effect_id",
    "job_id",
    "idempotency_key",
    "normalized_request_digest",
    "side_effect_class",
    "target_subject",
    "preconditions",
    "approval_requirement",
    "compensation",
    "contract_set_ref"
  ],
  "properties": {
    "schema": {
      "const": "runtime-env/dual-agent/effect-intent/v1"
    },
    "effect_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "normalized_request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "side_effect_class": {
      "enum": [
        "REVERSIBLE_WRITE",
        "IRREVERSIBLE_WRITE"
      ]
    },
    "target_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approval_requirement": {
      "enum": [
        "BEFORE_EXTERNAL_WRITE",
        "BEFORE_IRREVERSIBLE_ACTION"
      ]
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "plan_digest"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "DECLARED",
            "HUMAN_OWNED",
            "NOT_POSSIBLE"
          ]
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "contract_set_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "manifest_digest"
      ],
      "properties": {
        "schema": {
          "const": "runtime-env/dual-agent/contract-set-manifest/v1"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
