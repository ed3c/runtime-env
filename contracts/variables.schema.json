{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/runtime-env/blob/main/contracts/variables.schema.json",
  "title": "runtime-env variable catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "variables"],
  "properties": {
    "schema": {"const": "runtime-env/variables/v1"},
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secret", "runtime_scope", "description"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "secret": {"type": "boolean"},
          "runtime_scope": {
            "enum": ["local-only", "cloud-runtime", "portable"]
          },
          "description": {"type": "string", "minLength": 1},
          "account_url": {"type": "string", "pattern": "^https://"}
        }
      }
    }
  }
}
