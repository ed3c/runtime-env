{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-env.invalid/skill-runtime-requirements/v1",
  "title": "Skill Runtime Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skill", "capabilities", "modes"],
  "properties": {
    "schema": {"const": "skills-shared/skill-runtime-requirements/v1"},
    "skill": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "optional": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["local", "actions", "connector", "public-consumer"]}
    }
  }
}
