{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/runtime-env/blob/main/contracts/consumer-binding.schema.json",
  "title": "runtime-env consumer binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding", "profile", "source", "variables", "render", "content_sha256"],
  "properties": {
    "schema": {"const": "runtime-env/consumer-binding/v1"},
    "binding": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "secret", "description"],
        "allOf": [
          {
            "if": {"properties": {"secret": {"const": true}}, "required": ["secret"]},
            "then": {"not": {"required": ["default"]}}
          }
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "required": {"type": "boolean"},
          "secret": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "account_url": {"type": "string", "pattern": "^https://"},
          "default": {"type": "string"}
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": {"const": "dotenv"},
        "path": {"type": "string", "pattern": "^\\.runtime-env/examples/[a-z0-9-]+\\.env\\.example$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
